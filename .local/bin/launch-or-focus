#!/bin/bash
# launch-or-focus: Focus an existing window and switch to its workspace, or launch it

if (($# == 0)); then
  echo "Usage: launch-or-focus <window-pattern> [launch-command]" >&2
  exit 1
fi

WINDOW_PATTERN="$1"
LAUNCH_COMMAND="${2:-$WINDOW_PATTERN}"

# Search for matching window address and workspace across all workspaces
# 1. Exact class or initialClass match
WINDOW_DATA=$(hyprctl clients -j 2>/dev/null | jq -r --arg p "$WINDOW_PATTERN" '
  .[] | select((.class // "" | test("^" + $p + "$"; "i")) or (.initialClass // "" | test("^" + $p + "$"; "i"))) | "\(.address) \(.workspace.id)"
' | head -n1)

# 2. Substring match on title / initialTitle if class did not match
if [[ -z "$WINDOW_DATA" || "$WINDOW_DATA" == "null "* ]]; then
  WINDOW_DATA=$(hyprctl clients -j 2>/dev/null | jq -r --arg p "$WINDOW_PATTERN" '
    .[] | select((.title // "" | test($p; "i")) or (.initialTitle // "" | test($p; "i"))) | "\(.address) \(.workspace.id)"
  ' | head -n1)
fi

read -r ADDR WS <<< "$WINDOW_DATA"

if [[ -n "$ADDR" && -n "$WS" && "$ADDR" != "null" && "$WS" != "null" ]]; then
  hyprctl dispatch "hl.dsp.focus({ workspace = \"$WS\" })" >/dev/null 2>&1
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$ADDR\" })" >/dev/null 2>&1
else
  eval exec setsid $LAUNCH_COMMAND &
fi

# ~/.config/ghostty/config

# Ghostty Configuration File

command = /usr/bin/zsh

# Theme
#theme = AlienBlood
#theme = RetroLegends
theme = dark:Brogrammer,light:Catppuccin Latte
#theme = ENCOM
#theme = "Catppuccin Mocha"

# Font Configuration
font-family = "MesloLGS Nerd Font"
font-size = 14

# Background Opacity
#background-opacity = 0.88

#window-position-x = 80
#window-position-y = 80
window-width = 110
window-height = 28

#background = 000000

copy-on-select = clipboard

# Force new windows to open in your home directory
working-directory = home

# Do not inherit the path of the last active terminal
window-inherit-working-directory = false

# Window Behavior
#confirm-close-surface = false

window-decoration = auto

# Cursor
#shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 50000
mouse-scroll-multiplier = 1

# Padding
window-padding-x = 4
window-padding-y = 4

# ==========================================
# --- TABS & SPLITS (PANES) KEYBINDINGS ---
# ==========================================

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab

# Splits (Panes)
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+e=new_split:down

# Split Navigation (Use Ctrl + Arrows to move between panes)
keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right
keybind = ctrl+up=goto_split:up
keybind = ctrl+down=goto_split:down

# Tmux-like "Zoom" (Toggle current pane to fullscreen and back)
keybind = ctrl+shift+enter=toggle_split_zoom

# Resizing Splits (Ctrl + Shift + Arrows)
keybind = ctrl+shift+left=resize_split:left,10
keybind = ctrl+shift+right=resize_split:right,10
keybind = ctrl+shift+up=resize_split:up,10
keybind = ctrl+shift+down=resize_split:down,10
